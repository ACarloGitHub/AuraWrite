{
  "identifier": "main",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "*://*:*" },
        { "url": "http://localhost" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
  ]
}
